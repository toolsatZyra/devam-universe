# Publishable credentials only. Never put a service-role or secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Exact public origin used in passwordless email redirects. Required in
# production to prevent Host-header-derived redirect destinations.
DEVAM_SITE_URL=https://devam.example

# Server runtime only. Never prefix this with NEXT_PUBLIC_ and never expose it
# to browser code. Required for private evidence retrieval and ingestion workers.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only rollout gate. Leave false until the local subscriptions migration
# has been reviewed and applied to the isolated Devam Supabase project.
DEVAM_SUBSCRIPTIONS_ENABLED=false

# Optional server-only Sarthi answer composition. Retrieval, deterministic
# Panchang, and ritual guidance continue to work when this is disabled. Never
# expose the API key to browser code.
SARTHI_GENERATION_ENABLED=false
OPENAI_API_KEY=
SARTHI_OPENAI_MODEL=gpt-5.6-terra
